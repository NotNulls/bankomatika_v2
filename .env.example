# ---------------------------------------------------------------------------
# Bank Statement Converter — environment template
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# development | production | testing
FLASK_ENV=development

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret

# PostgreSQL is required in production. SQLite is used automatically for local
# development when this is unset and for the automated test suite.
# DATABASE_URL=postgresql://bsk_user:strong_password@127.0.0.1:5432/bank_statement_converter

# Optional paths and limits
# UPLOAD_FOLDER=/var/lib/bank-statement-converter/uploads
MAX_CONTENT_LENGTH_MB=25
CONVERSION_RETENTION_SECONDS=3600
MAX_PDF_PAGES=500
MAX_ROWS_PER_STATEMENT=50000
CLEANUP_INTERVAL_SECONDS=300

# Set to 1 only behind a trusted reverse proxy/CDN that overwrites
# X-Forwarded-For and X-Forwarded-Proto.
TRUST_PROXY_HEADERS=0

# Production defaults to secure cookies. Only set to 0 for a local HTTP-only
# Docker demo; keep secure cookies enabled behind TLS.
# SESSION_COOKIE_SECURE=1

# Hashing salt for anonymous usage logs. If unset, SECRET_KEY is used.
IP_HASH_SALT=replace-with-a-separate-random-salt
# Keyed pepper for API key hashes. If unset, SECRET_KEY is used.
API_KEY_HASH_PEPPER=replace-with-a-separate-random-pepper

# Public contact details
SUPPORT_EMAIL=support@your-domain.example
SALES_EMAIL=sales@your-domain.example

# Demo API key printed by seed.py (change for any shared environment)
DEMO_API_KEY=bsk_live_demo_business_8f3a1c9e7b2d4f6a

# Optional server binding for run.py
HOST=127.0.0.1
PORT=5000
